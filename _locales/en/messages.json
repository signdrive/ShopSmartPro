  "welcomeTitle": { "message": "Welcome to ShopSmart Pro!", "description": "Main title of the welcome section" },
  "welcomeDescription": { "message": "ShopSmart Pro is a powerful browser extension designed to enhance your online shopping experience on Amazon and eBay. This guide will walk you through its features and how to use them effectively.", "description": "Description in the welcome section" },
  "getStartedSteps": { "message": "Follow these simple steps to get started:", "description": "Introduction to the getting started steps" },
  "stepToolbarIcon": { "message": "Click the ShopSmart Pro icon in your browser's toolbar to open the main popup.", "description": "First step in getting started" },
  "stepSearchBox": { "message": "Use the search box to look for products on the current site (Amazon or eBay).", "description": "Second step in getting started" },
  "stepSelectCategories": { "message": "Select a category to narrow down your search results.", "description": "Third step in getting started" },
  "stepSearchOrEnter": { "message": "Click 'Search Store' or press Enter to see the results.", "description": "Fourth step in getting started" },
  "stepRightClickMenu": { "message": "Right-click on any product page to access quick actions like 'Track Price' or 'Add to Comparison'.", "description": "Fifth step in getting started" },
  "featurePriceTracking": { "message": "Price Tracking", "description": "Title of the price tracking feature" },
  "featurePriceTrackingDesc": { "message": "Never miss a price drop. Track any product and get notified when the price changes.", "description": "Description of the price tracking feature" },
  "featurePriceComparison": { "message": "Product Comparison", "description": "Title of the product comparison feature" },
  "featurePriceComparisonDesc": { "message": "Compare multiple products side-by-side. Add products from any page to your comparison list.", "description": "Description of the product comparison feature" },
  "featureDealFinder": { "message": "Deal Finder", "description": "Title of the deal finder feature" },
  "featureDealFinderDesc": { "message": "Discover the best deals and discounts available right now with our integrated deal finder.", "description": "Description of the deal finder feature" },
  "featureVoiceSearch": { "message": "Voice Search", "description": "Title of the voice search feature" },
  "featureVoiceSearchDesc": { "message": "Search for products using your voice for a hands-free experience.", "description": "Description of the voice search feature" },
  "featureSidePanel": { "message": "Side Panel Integration", "description": "Title of the side panel feature" },
  "featureSidePanelDesc": { "message": "Access all of ShopSmart Pro's features without leaving your current page using the convenient side panel.", "description": "Description of the side panel feature" },
  "troubleshootingIntro": { "message": "Having issues? Here are some common problems and their solutions:", "description": "Introduction to the troubleshooting section" },
  "troubleNotWorking": { "message": "Extension not working on a product page? Try reloading the page. If the issue persists, make sure you are on a supported Amazon or eBay domain.", "description": "Troubleshooting step 1" },
  "troubleNoDeals": { "message": "Not seeing any deals? Deals are updated periodically. Try again later or check your connection.", "description": "Troubleshooting step 2" },
  "troubleLogin": { "message": "Issues related to login? ShopSmart Pro does not require a login. All data is stored locally on your device.", "description": "Troubleshooting step 3" },
  "faqWhichSites": { "message": "Which sites are supported?", "description": "FAQ question 1" },
  "faqWhichSitesAnswer": { "message": "ShopSmart Pro currently supports Amazon and eBay domains across multiple countries.", "description": "FAQ answer 1" },
  "faqDataSecure": { "message": "Is my data secure?", "description": "FAQ question 2" },
  "faqDataSecureAnswer": { "message": "Yes. All your data, including tracked products and search history, is stored locally on your computer. We do not collect or sell your personal data. See our Privacy Policy for more details.", "description": "FAQ answer 2" },
  "faqHowToUpdate": { "message": "How do I update the extension?", "description": "FAQ question 3" },
  "faqHowToUpdateAnswer": { "message": "The extension will update automatically. You can also manually update it from your browser's extensions page.", "description": "FAQ answer 3" },
