  "faqDataSecure": { "message": "Sind meine Daten sicher?", "description": "FAQ Frage 2" },
  "faqDataSecureAnswer": { "message": "Ja. Alle Ihre Daten, einschließlich verfolgter Produkte und Suchverlauf, werden lokal auf Ihrem Computer gespeichert. Wir sammeln oder verkaufen Ihre persönlichen Daten nicht. Weitere Informationen finden Sie in unserer Datenschutzrichtlinie.", "description": "FAQ Antwort 2" },
  "faqHowToUpdate": { "message": "Wie aktualisiere ich die Erweiterung?", "description": "FAQ Frage 3" },
  "faqHowToUpdateAnswer": { "message": "Die Erweiterung wird automatisch aktualisiert. Sie können sie auch manuell über die Erweiterungsseite Ihres Browsers aktualisieren.", "description": "FAQ Antwort 3" },
  "privacyPolicyIntro": { "message": "Wir nehmen Ihren Datenschutz ernst. Unsere Erweiterung ist so konzipiert, dass sie funktioniert, ohne personenbezogene Daten von Benutzern zu sammeln.", "description": "Einführung in den Abschnitt zur Datenschutzrichtlinie" },
