  "welcomeTitle": { "message": "Willkommen bei ShopSmart Pro!", "description": "Haupttitel des Willkommensbereichs" },
  "welcomeDescription": { "message": "ShopSmart Pro ist eine leistungsstarke Browsererweiterung, die Ihr Online-Einkaufserlebnis bei Amazon und eBay verbessern soll. In diesem Handbuch werden die Funktionen vorgestellt und erläutert, wie Sie sie effektiv nutzen können.", "description": "Beschreibung im Willkommensbereich" },
