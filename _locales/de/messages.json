  "troubleshootingIntro": { "message": "Haben Sie Probleme? Hier sind einige häufige Probleme und ihre Lösungen:", "description": "Einführung in den Abschnitt zur Fehlerbehebung" },
  "troubleNotWorking": { "message": "Die Erweiterung funktioniert auf einer Produktseite nicht? Versuchen Sie, die Seite neu zu laden. Wenn das Problem weiterhin besteht, stellen Sie sicher, dass Sie sich auf einer unterstützten Amazon- oder eBay-Domain befinden.", "description": "Fehlerbehebung Schritt 1" },
  "troubleNoDeals": { "message": "Keine Angebote gefunden? Angebote werden regelmäßig aktualisiert. Versuchen Sie es später erneut oder überprüfen Sie Ihre Verbindung.", "description": "Fehlerbehebung Schritt 2" },
  "troubleLogin": { "message": "Anmeldeprobleme? ShopSmart Pro erfordert keine Anmeldung. Alle Daten werden lokal auf Ihrem Gerät gespeichert.", "description": "Fehlerbehebung Schritt 3" },
  "faqWhichSites": { "message": "Welche Websites werden unterstützt?", "description": "FAQ Frage 1" },
