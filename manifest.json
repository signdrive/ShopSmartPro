{
  "manifest_version": 3,
  "name": "ShopSmart Pro",
  "version": "2.37",
  "description": "Enhances your shopping experience on Amazon and eBay with price tracking, comparisons, and deal alerts",
  "author": "ShopSmart Team",
  "default_locale": "en",
  "homepage_url": "https://www.shopsmartpro.com",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none';"
  },
  "permissions": [
   "storage",
    "tabs",
    "contextMenus",
    "notifications",
    "alarms",
  "sidePanel"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "*://*.amazon.co.jp/*",
    "*://*.amazon.com.au/*",
    "*://*.amazon.com.br/*",
    "*://*.amazon.com.mx/*",
    "*://*.amazon.nl/*",
    "https://api.ebay.com/*",
    "https://svcs.ebay.com/*",
    "https://i.ebayimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "ShopSmart Pro"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.nl/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "commands": {
    "quick-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Open quick Amazon search"
    },
    "voice-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Start voice search"
    },
    "ebay-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open eBay search"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "sounds/alert.mp3",
        "popup/popup.html",
        "popup/comparison.html",
        "deals/deals.html",
        "ebay/ebay.html",
        "settings/settings.html",
        "about.html",
        "privacy.html",
        "documentation.html",
        "img/ebay/*",
        "img/deals/placeholder.jpg",
        "tracked/tracked.js",
        "tracked/tracked.css",
        "tracked/tracked.html",
        "sidepanel/sidepanel.html",
        "sidepanel/sidepanel.css",
        "sidepanel/sidepanel.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}

