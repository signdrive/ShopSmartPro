{
  "manifest_version": 2,
  "name": "ShopSmart Pro",
  "version": "2.35",
  "description": "Enhances your shopping experience on Amazon and eBay with price tracking, comparisons, and deal alerts",
  "author": "ShopSmart Team",
  "homepage_url": "https://www.shopsmartpro.com",
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'none'",
  "browser_specific_settings": {
    "gecko": {
      "id": "shopsmart-pro@parkalgo.com",
      "strict_min_version": "91.0"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "notifications",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "*://*.amazon.com/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "*://*.amazon.co.jp/*",
    "*://*.amazon.com.au/*",
    "*://*.amazon.com.br/*",
    "*://*.amazon.com.mx/*",
    "*://*.amazon.nl/*",
    "https://api.ebay.com/",
    "https://svcs.ebay.com/",
    "https://i.ebayimg.com/"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "ShopSmart Pro"
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "ShopSmart Pro",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.nl/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true,
    "browser_style": true
  },
  "commands": {
    "quick-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Open quick Amazon search"
    },
    "voice-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Start voice search"
    },
    "ebay-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open eBay search"
    }
  },
  "web_accessible_resources": [
    "icons/*.png",
    "sound/alert.mp3",
    "popup/popup.html",
    "popup/comparison.html",
    "deals/deals.html",
    "ebay/ebay.html",
    "settings/settings.html",
    "about.html",
    "privacy.html",
    "documentation.html",
    "img/ebay/*",
    "img/deals/placeholder.jpg",
    "tracked/chart.min.js",
    "tracked/tracked.js",
    "tracked/tracked.css",
    "tracked/tracked.html",
    "sidebar/sidebar.html",
    "sidebar/sidebar.css",
    "sidebar/sidebar.js"
  ]
}