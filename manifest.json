{
  "manifest_version": 2,
  "name": "ShopSmart Pro",
  "version": "2.33",
  "description": "Enhances your shopping experience on Amazon with price tracking, comparisons, and deal alerts",
  "author": "ShopSmart Team",
  "homepage_url": "https://www.shopsmartpro.com",

  "content_security_policy": "script-src 'self'; object-src 'none'",

  "browser_specific_settings": {
    "gecko": {
      "id": "shopsmart-pro@parkalgo.com",
      "strict_min_version": "91.0"
    }
  },

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "notifications",
    "alarms",
    "webRequest",
    "webRequestBlocking",
    "*://*.amazon.com/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.de/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "*://*.amazon.co.jp/*",
    "*://*.amazon.com.au/*",
    "*://*.amazon.com.br/*",
    "*://*.amazon.com.mx/*",
    "*://*.amazon.nl/*",
    "*://api.ebay.com/*",
    "*://i.ebayimg.com/*",
    "*://via.placeholder.com/*"
  ],

  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },

  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "ShopSmart Pro"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.de/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.nl/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com/*"
      ],
      "js": ["ebay/ebay-content.js"],
      "css": ["ebay/ebay.css"],
      "run_at": "document_start"
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true,
    "browser_style": true
  },

  "commands": {
    "quick-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Open quick Amazon search"
    },
    "voice-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Start voice search"
    },
    "ebay-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open eBay search"
    }
  },

  "web_accessible_resources": [
    "icons/icon-16.png",
    "icons/icon-32.png",
    "icons/icon-48.png",
    "icons/icon-96.png",
    "sound/alert.mp3",
    "about.html",
    "about.css",
    "about.js",
    "documentation.html",
    "documentation.css",
    "documentation.js",
    "privacy.html",
    "privacy.css",
    "privacy.js",
    "popup/popup.html",
    "popup/popup.css",
    "popup/popup.js",
    "popup/comparison.html",
    "popup/comparison.css",
    "popup/comparison.js",
    "deals/deals.html",
    "deals/deals.css",
    "deals/deals.js",
    "ebay/ebay.html",
    "ebay/ebay.css",
    "ebay/ebay.js",
    "settings/settings.html",
    "settings/settings.css",
    "settings/settings.js",
    "img/deals/*.jpg",
    "img/deals/placeholder.jpg",
    "img/ebay/*.png",
    "img/ebay/logo.png",
    "img/ebay/favicon.ico",
    "img/ebay/loading.gif",
    "img/ebay/error.png",
    "img/ebay/no-results.png",
    "img/ebay/compare-icon.png"
  ]
}